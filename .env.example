# REST API (apps/server)
ORIEL_HOST=127.0.0.1
ORIEL_PORT=8787
# ORIEL_ORIGINS=http://localhost:5173
# Optional shared secret; when set, clients must send X-Api-Token (or ?token=).
# ORIEL_TOKEN=

# Web client (apps/web)
VITE_API_BASE_URL=http://127.0.0.1:8787
# Must match ORIEL_TOKEN when that is set.
# VITE_API_TOKEN=

# GitHub repository used by "设置 → 关于 → 检查更新" (owner/name).
# ORIEL_UPDATE_REPO=
# Optional CDN prefix for release assets (<cdn>/<tag>/<file>), for networks where
# GitHub asset hosts are blocked. Mirror the release assets under that layout.
# ORIEL_UPDATE_CDN=
