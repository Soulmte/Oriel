# Local API served by the Rust service (inside Oriel, or `npm run dev:api`).
ORIEL_PORT=8787
# Optional shared secret; when set, clients must send X-Api-Token (or ?token=).
# ORIEL_TOKEN=

# Web client
VITE_API_BASE_URL=http://127.0.0.1:8787
# Must match ORIEL_TOKEN when that is set.
# VITE_API_TOKEN=

# Update check sources (owner/name). The packaged app sets these itself.
# ORIEL_UPDATE_REPO=
# ORIEL_UPDATE_GITEE=
# Optional CDN prefix for release assets (<cdn>/<tag>/<file>).
# ORIEL_UPDATE_CDN=
